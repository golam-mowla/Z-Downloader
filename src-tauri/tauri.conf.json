{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Z Downloader",
  "version": "0.0.0",
  "identifier": "com.golammowla.zdownloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Z Downloader // Cyberpunk Edition",
        "width": 1100,
        "height": 840,
        "minWidth": 400,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
